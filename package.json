{
  "name": "still-logbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": ".venv/bin/python -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/backfill-documents.mjs --emit dist/backfill.mjs",
    "start": "sh scripts/start.sh",
    "test": ".venv/bin/python -m pytest backend/tests -q",
    "test:editor-model": "node scripts/check-editor-model.mjs",
    "test:e2e": "npm run build && playwright test",
    "migrate:documents": "node scripts/backfill-documents.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^0.577.0",
    "prosemirror-markdown": "^1.13.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^6.3.9"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.25.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0"
  }
}
